{
  "name": "rw-max-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Бот АО «АК «ЖДЯ» для мессенджера MAX",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "chat": "tsx src/cli/chat.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/content/seed.ts",
    "generate-images": "tsx image-generator/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "^1.0.2",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "node-html-to-image": "^5.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
