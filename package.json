{
  "name": "rw-max-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Бот АО «АК «ЖДЯ» для мессенджера MAX: API, бот и админка",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rw/api --filter @rw/bot --filter @rw/admin dev",
    "dev:api": "pnpm --filter @rw/api dev",
    "dev:bot": "pnpm --filter @rw/bot dev",
    "dev:admin": "pnpm --filter @rw/admin dev",
    "chat": "pnpm --filter @rw/bot chat",
    "eval:e5": "pnpm --filter @rw/bot eval:e5",
    "retrieval:report": "pnpm --filter @rw/bot retrieval:report",
    "calibrate:policy": "pnpm --filter @rw/bot calibrate:policy",
    "benchmark:search": "pnpm --filter @rw/bot benchmark:search",
    "admin:create": "pnpm --filter @rw/api admin:create",
    "db:generate": "pnpm --filter @rw/db generate",
    "db:migrate": "pnpm --filter @rw/db migrate",
    "db:seed": "pnpm --filter @rw/db seed",
    "generate-images": "tsx tools/image-generator/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "node-html-to-image": "^5.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
