# Два адреса: DOMAIN открыт наружу только для вебхука MAX, ADMIN_DOMAIN — админка и API, адрес закрывает контур заказчика.
# Сертификат DOMAIN Caddy получает через открытые 80 и 443, сертификат ADMIN_DOMAIN — через DNS: см. deploy/README.md

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

{$DOMAIN} {
	import security_headers

	# Подлинность запроса бот проверяет сам по заголовку X-Max-Bot-Api-Secret
	handle /webhook {
		reverse_proxy bot:3000
	}

	handle {
		respond 404
	}
}

{$ADMIN_DOMAIN} {
	tls {
		dns rfc2136 {
			key_name acme
			key_alg hmac-sha256
			key {$ACME_TSIG_SECRET}
			server dns:53
		}
		# TXT-запись появляется на нашем же DNS-сервере сразу, внешний адрес проверять незачем
		resolvers dns:53
		propagation_timeout -1
	}

	import security_headers
	encode zstd gzip

	# В API проксируется только /api: /internal/* для бота доступен лишь внутри docker-сети
	handle /api/* {
		reverse_proxy api:3001
	}

	# Админка: SPA, неизвестные пути отдают index.html
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
