# Наружу открыт только вебхук MAX. Админка на этот сервер не выкладывается.
# Caddy сам получает и продлевает сертификат Let's Encrypt для DOMAIN (нужны открытые 80 и 443)

{$DOMAIN} {
	# Подлинность запроса бот проверяет сам по заголовку X-Max-Bot-Api-Secret
	handle /webhook {
		reverse_proxy bot:3000
	}

	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

# Пока только сертификат, сама админка выкладывается отдельно.
# Адрес админки закрыт контуром, поэтому проверка идет через DNS: см. deploy/README.md
{$ADMIN_DOMAIN} {
	tls {
		dns rfc2136 {
			key_name acme
			key_alg hmac-sha256
			key {$ACME_TSIG_SECRET}
			server dns:53
		}
		# TXT-запись появляется на нашем же DNS-сервере сразу, внешний адрес проверять незачем
		resolvers dns:53
		propagation_timeout -1
	}

	respond 404
}
