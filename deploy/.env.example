# Переменные сервера: /opt/rw-max-bot/.env (вне папки с кодом — переживает выкладки).
# Секреты генерирует deploy/server-setup.sh; BOT_TOKEN вписать вручную.

# Публичный домен: только вебхук MAX
DOMAIN=max-bot.rw-y.ru

# Адрес админки в закрытом контуре: сертификат подтверждается через DNS, см. deploy/README.md
ADMIN_DOMAIN=max-admin.rw-y.ru
# Внутренний адрес сетевой карты, на которую приходит DOMAIN
ACME_DNS_BIND_IP=192.168.78.12
# Ключ, которым Caddy меняет записи на DNS-сервере: openssl rand -base64 32
ACME_TSIG_SECRET=

# Токен бота: business.max.ru → Чат-боты → бот → Настройки → «Токен бота»
BOT_TOKEN=

# Случайные строки ([A-Za-z0-9_-])
POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
WEBHOOK_SECRET=

CONTENT_REFRESH_SECONDS=300

# Чат с оператором: true только когда сотрудникам открыта админка, см. deploy/README.md
SUPPORT_CHAT_ENABLED=false

# Семантический поиск: E5 + реранкер BGE (0 — только E5). Пороги по умолчанию — из калибровки, см. README
RERANK_DEPTH=10
LOG_LEVEL=info
