# Переменные сервера: /opt/rw-max-bot/.env (вне папки с кодом — переживает выкладки).
# Секреты генерирует deploy/server-setup.sh; BOT_TOKEN вписать вручную.

# Публичный домен: только вебхук MAX
DOMAIN=max-bot.rw-y.ru

# Токен бота: business.max.ru → Чат-боты → бот → Настройки → «Токен бота».
# Локально с этим токеном бота не запускать: режим polling снимает подписку на вебхук
BOT_TOKEN=

# Случайные строки ([A-Za-z0-9_-])
POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
WEBHOOK_SECRET=

CONTENT_REFRESH_SECONDS=300

# Семантический поиск: E5 + реранкер BGE (0 — только E5). Пороги по умолчанию — из калибровки, см. README
RERANK_DEPTH=10
LOG_LEVEL=info
