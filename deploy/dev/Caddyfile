# Дев-стенд повторяет схему заказчика: вебхук и админка на разных адресах.
# Ограничение доступа к админке у заказчика делает его внешний контур. На стенде такого контура нет,
# админку защищает только вход, поэтому на стенде только начальный контент и тестовые пользователи.
#
# HTTPS принимает Caddy войсрума (deploy/dev/voiceroom-sites.caddy) и передает сюда запросы по HTTP с исходным Host.
# Этот Caddy подключен и к сети войсрума, где есть свои api и postgres: поэтому наши сервисы названы уникально.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

http://{$DOMAIN} {
	import security_headers

	# Подлинность запроса бот проверяет сам по заголовку X-Max-Bot-Api-Secret
	handle /webhook {
		reverse_proxy rw-max-bot-bot:3000
	}

	handle {
		respond 404
	}
}

http://{$ADMIN_DOMAIN} {
	import security_headers
	encode zstd gzip

	# В API проксируется только /api: /internal/* для бота доступен лишь внутри docker-сети
	handle /api/* {
		reverse_proxy rw-max-bot-api:3001
	}

	# Админка: SPA, неизвестные пути отдают index.html
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
