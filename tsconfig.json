{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,

    "baseUrl": "./src",
    "paths": {
      "~": ["."],
      "~/*": ["*"]
    }
  },

  "include": ["src", "image-generator", "drizzle.config.ts", "vitest.config.ts"]
}
