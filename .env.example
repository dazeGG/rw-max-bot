# Настройки инструментов поиска на машине разработчика (pnpm eval:e5, retrieval:report, calibrate:policy).
# Переменные сервисов на сервере: deploy/.env.example

# E5-only semantic search (CPU, multilingual-e5-small q8)
# Optional cache directory; default .cache/e5 in the repository
# E5_CACHE_DIR=
# Used only with RERANK_DEPTH=0
# E5_THRESHOLD=0.84
# E5_AMBIGUITY_GAP=0.025
# Button labels matched by E5; defaults 0.91/0.002 with the reranker, 0.86/0.015 without
# E5_OPTION_THRESHOLD=0.91
# E5_OPTION_GAP=0.002
# Threads per model; set to the number of CPU cores on smaller servers
# ONNX_THREADS=2

# BGE reranker (bge-reranker-v2-m3 q8) rescores the first RERANK_DEPTH E5 results; 0 turns it off.
# ~1.1 GB more RAM, ~0.35 s per question on 2 vCPU. With it on, the global answer uses RERANK_* thresholds
# instead of E5_THRESHOLD/E5_AMBIGUITY_GAP (sigmoid of the reranker logit, not a probability).
# Defaults are calibrated by `pnpm calibrate:policy`; uncomment only to override.
RERANK_DEPTH=10
# How far the E5 lag behind its leader (x100) shifts the reranker logit
# RERANK_E5_WEIGHT=0.5
# RERANK_THRESHOLD=0.9
# RERANK_AMBIGUITY_GAP=0.15
# Leaders above this but below the threshold are offered as a choice; 0.2 offers fewer unrelated choices
# RERANK_CLARIFY_THRESHOLD=0.02

LOG_LEVEL=info
