# Токен бота: business.max.ru → Чат-боты → бот → Настройки → «Токен бота»
BOT_TOKEN=

# PostgreSQL (локально поднимается через `docker compose up -d`). Нужен только API
DATABASE_URL=postgres://rw:rw@localhost:5433/rw_max_bot

# API: бот и админка работают с данными только через него
API_HOST=127.0.0.1
API_PORT=3001
# Адрес API для бота
API_URL=http://127.0.0.1:3001
# Внутренний HTTP-сервер бота для сигнала обновления контента
BOT_CONTROL_URL=http://127.0.0.1:3002
BOT_CONTROL_HOST=127.0.0.1
BOT_CONTROL_PORT=3002
# Общий секрет бота и API (любая длинная случайная строка)
INTERNAL_API_TOKEN=
# true на сервере (админка по HTTPS): cookie входа не уходит по открытому HTTP
ADMIN_COOKIE_SECURE=false

# polling — для локальной разработки (не нужен сервер и HTTPS)
# webhook — для сервера (нужен HTTPS-адрес на порту 443)
BOT_MODE=polling

# Только для BOT_MODE=webhook
WEBHOOK_DOMAIN=https://max-bot.rw-y.ru
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
PORT=3000

# Резервная проверка контента, если внутренний сигнал не дошёл
CONTENT_REFRESH_SECONDS=300

# E5-only semantic search (CPU, multilingual-e5-small q8)
# Optional cache directory; default .cache/e5 in the repository
# E5_CACHE_DIR=
E5_THRESHOLD=0.84
E5_AMBIGUITY_GAP=0.025
E5_OPTION_THRESHOLD=0.86
E5_OPTION_GAP=0.015

# BGE reranker (bge-reranker-v2-m3 q8) rescores the first RERANK_DEPTH E5 results; 0 turns it off.
# ~1.1 GB more RAM, ~0.35 s per question on 2 vCPU. With it on, the global answer uses RERANK_* thresholds
# instead of E5_THRESHOLD/E5_AMBIGUITY_GAP (sigmoid of the reranker logit, not a probability).
RERANK_DEPTH=10
RERANK_THRESHOLD=0.8
RERANK_AMBIGUITY_GAP=0.01

LOG_LEVEL=info
